# Tüm değerler YALNIZCA sunucuda okunur; tarayıcıya hiçbir Firebase yapılandırması gitmez.
# Firebase Console -> Project settings -> Service accounts -> "Generate new private key" JSON'undan:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSON'daki private_key; tek satırda "\n" kaçışlarıyla verilebilir.
FIREBASE_PRIVATE_KEY=
# Firebase Console -> Project settings -> General -> Web API Key (şifre girişini Identity Toolkit'e iletmek için)
FIREBASE_WEB_API_KEY=
