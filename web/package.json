{
  "name": "job-discovery-web",
  "version": "0.1.0",
  "private": true,
  "description": "Kişisel iş ilanı keşif sistemi — Next.js web arayüzü (Supabase Auth + Postgres)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
