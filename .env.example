# Google Cloud Console'da oluşturulan "Desktop app" OAuth istemcisi
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# oauth:setup komutunun dinlediği loopback adresi
GMAIL_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback

# oauth:setup bu değeri .env.local dosyasına güvenli biçimde ekler
GMAIL_REFRESH_TOKEN=

# Gmail'de sadece iş alarmı e-postalarına verdiğiniz etiket (tam ad)
GMAIL_JOB_LABEL=Is-Alarmi

# İsteğe bağlı: bir çalışmada okunacak azami e-posta (varsayılan 100)
GMAIL_MAX_MESSAGES=100

# Yalnızca yerel geliştirme deposu; Vercel kalıcılığı için kullanılamaz
JOB_STORE_PATH=data/jobs.json

# Depo seçimi: "json" (yerel data/jobs.json) veya "firestore" (web arayüzüyle aynı Firebase projesi)
JOB_STORE=json

# JOB_STORE=firestore için: web uygulamasında oturum açan hesabın e-postası (ilanlar bu hesabın altına yazılır)
JOB_OWNER_EMAIL=

# JOB_STORE=firestore için servis hesabı (web/.env.local ile aynı değerler; Git dışıdır)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# İsteğe bağlı Telegram bildirimi: BotFather token'ı; TELEGRAM_CHAT_ID "npm run telegram:setup" ile otomatik yazılır
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bildirim mesajının sonuna eklenecek liste bağlantısı (isteğe bağlı)
APP_URL=https://job-discovery-tr.vercel.app
